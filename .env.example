# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/chat_backend?schema=public"
PORT=3000
# Service account for the Firebase project with Authentication and Firestore enabled.
# Keep the credential file outside version control.
FIREBASE_SERVICE_ACCOUNT_PATH="credentials/firebase-service-account.json"
# Optional inputs required by npm run test:integration.
FIREBASE_WEB_API_KEY=""
FIREBASE_TEST_PASSWORD=""
